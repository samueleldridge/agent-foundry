# agent-foundry environment template (docs/84, docs/85 § Example env manifest).
# Copy per environment; every value here is NON-secret configuration.
#
# SECRETS COME FROM YOUR SECRETS PROVIDER, NEVER THIS FILE.
# API keys, tokens, and connection-string credentials are injected at deploy
# time by the platform's secret machinery (k8s secretKeyRef, ECS
# secretsmanager valueFrom, Cloud Run secretKeyRef, `fly secrets set`, Nomad
# vault templates — see the sibling manifests). The foundry reads them as
# plain env vars at runtime; foundry.config's secret-literal scan rejects
# credentials that leak into YAML.

# --- core ---------------------------------------------------------------------
# Environment name; `prod` hardens defaults (e.g. NoAuth is refused).
FOUNDRY_ENV=prod
# Absolute path of the project the API serves (set automatically by
# `foundry serve <path>`; set explicitly for uvicorn multi-worker factories).
FOUNDRY_SERVE_PROJECT=/app/projects/hello
# Root for run artifacts / eval history / checkpoint dbs (default ~/.foundry).
# Multi-worker deployments on one host must share this directory.
FOUNDRY_HOME=/data/foundry
# Comma-separated catalog roots, resolved left-to-right (docs/86).
FOUNDRY_CATALOG_ROOTS=/app/catalog

# --- runtime / scaling (docs/85) ---------------------------------------------
# Checkpointer: sqlite (default; enables resume + HITL), memory, or none.
FOUNDRY_CHECKPOINTER=sqlite
# Provider rate limiter: unset/off, in_process, or redis://host:6379/0.
FOUNDRY_RATE_LIMITER=in_process
# Token-bucket shape for the provider rate limiter.
FOUNDRY_RATE_LIMIT_RPS=10
FOUNDRY_RATE_LIMIT_BURST=20
# Backpressure: concurrent runs above this get 503 + Retry-After.
FOUNDRY_MAX_CONCURRENT_RUNS=100
# Graceful drain window on shutdown, seconds (keep below the platform's
# termination grace period — k8s manifest uses 150s).
FOUNDRY_DRAIN_TIMEOUT_S=120

# --- API surface (docs/70) -----------------------------------------------------
# Comma-separated bearer tokens; REQUIRED under FOUNDRY_ENV=prod.
# Secret — set via your secrets provider, shown here only for completeness:
# FOUNDRY_API_TOKENS=<from-secrets-provider>
# CORS allowed origins, comma-separated (unset = CORS off).
FOUNDRY_CORS_ORIGINS=
# URL prefix for all routes (endpoint versioning Pattern 2, e.g. /v1).
FOUNDRY_ROUTE_PREFIX=

# --- observability (docs/80) ----------------------------------------------------
# Tracing backend: off (default) or otel.
FOUNDRY_TRACING=otel
# OTLP collector endpoint the OTel exporter ships spans/metrics to.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Optional third-party trace sinks (opt-in; keys are SECRETS — inject them
# via the secrets provider, never commit):
# LANGSMITH_API_KEY=<from-secrets-provider>
# LANGFUSE_PUBLIC_KEY=<from-secrets-provider>
# LANGFUSE_SECRET_KEY=<from-secrets-provider>
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- artifact storage (docs/81) ---------------------------------------------------
# Backend for run/eval artifacts: local (default), s3, gcs, or azure.
FOUNDRY_STORAGE_BACKEND=local
# Bucket name for s3/gcs backends.
FOUNDRY_STORAGE_BUCKET=
# Key prefix inside the bucket/container.
FOUNDRY_STORAGE_PREFIX=foundry/
# Custom S3-compatible endpoint (MinIO, etc.).
FOUNDRY_STORAGE_ENDPOINT=
# Container name for the azure backend.
FOUNDRY_STORAGE_CONTAINER=

# --- provider credentials (SECRETS — from the secrets provider) -------------------
# ANTHROPIC_API_KEY=<from-secrets-provider>
# OPENAI_API_KEY=<from-secrets-provider>
